# Telegram MTProto (https://my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=
# Filled by `npm run login`. Keep it secret, never share it.
TG_SESSION=

# Channels to monitor (usernames without @, comma separated)
CHANNELS=it_freelance,needdev,react_jobs

# Bot from @BotFather and your personal chat id (message @userinfobot)
BOT_TOKEN=
OWNER_CHAT_ID=

DATABASE_URL=postgres://jobbot:jobbot@localhost:5433/jobbot
REDIS_URL=redis://localhost:6380

# Scoring profile (keywords, weights, filters); defaults to ./profile.json, reloaded on change
PROFILE_PATH=

# Minimum relevance (0-100) to notify
MIN_SCORE=45

# Optional: AI refinement of relevance
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: protects the HTTP API (send as x-api-key header). Empty = API only on localhost
API_KEY=
PORT=3000
